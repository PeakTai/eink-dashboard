# ---------- 依赖 ----------
node_modules/

# ---------- 构建产物 ----------
# 前端构建输出，由 npm run build 重新生成；
# cap sync 会把它复制到 android/app/src/main/assets/public（已由 android/.gitignore 忽略）
dist/

# ---------- 环境变量与签名文件 ----------
.env
.env.local
.env.*.local
*.jks
*.keystore

# ---------- 日志 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 工具临时目录 ----------
.trae-html-share-packages/
.screenshots/

# ---------- 说明 ----------
# android/ 目录需要提交，不要加入忽略列表：
# 它包含 MainActivity 原生改动（沉浸式全屏、屏幕常亮）、应用图标、Manifest 权限、
# Gradle 与签名配置；cap sync 不会重新生成原生工程，ignore 后这些改动会丢失。
# android/.gitignore 已排除其中的生成物：build/、.gradle/、local.properties、
# app/src/main/assets/public、capacitor.plugins.json、config.xml 等。
