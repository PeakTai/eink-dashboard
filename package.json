{
  "name": "my-eink-dashboard",
  "version": "1.0.0",
  "description": "墨水屏控制面板",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "android": "export JAVA_HOME=$(mise where java 21.0.2) && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:build": "npm run build && export JAVA_HOME=$(mise where java 21.0.2) && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/device": "^8.0.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/preferences": "latest",
    "lunar-typescript": "^1.8.7",
    "wok-ui": "^1.0.11"
  },
  "devDependencies": {
    "@capacitor/android": "latest",
    "@capacitor/cli": "latest",
    "less": "^4.6.4",
    "typescript": "~5.7.0",
    "vite": "^7.3.1"
  }
}
